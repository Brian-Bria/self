            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }
        .chat-header-info p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }
        .chat-status {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
            color: #059669;
            background: rgba(5, 150, 105, 0.08);
            padding: 6px 14px;
            border-radius: 20px;
            border: 1px solid rgba(5, 150, 105, 0.12);
            white-space: nowrap;
        }
        .chat-status .dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #059669;
            animation: pulse-dot 1.8s ease-in-out infinite;
        }
        @keyframes pulse-dot {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.4;
                transform: scale(0.7);
            }
        }

