        function sendChatMessage() {
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if (!msg) return;
            if (isChatProcessing) return;

            input.value = '';
            input.disabled = true;
            document.getElementById('chatSendBtn').disabled = true;
            isChatProcessing = true;

            appendMessage('user', msg);
            const thinkingId = appendThinkingMessage();

            setTimeout(() => {
                removeThinkingMessage(thinkingId);
                const reply = getUniqueReply();
                appendMessage('ai', reply);
                input.disabled = false;
                document.getElementById('chatSendBtn').disabled = false;
                isChatProcessing = false;
                input.focus();
                scrollChatToBottom();
            }, 5000);
        }

        function getUniqueReply() {
            let idx;
            do {
                idx = Math.floor(Math.random() * XIAOHUI_REPLIES.length);
            } while (idx === lastReplyIndex && XIAOHUI_REPLIES.length > 1);
            lastReplyIndex = idx;
            return XIAOHUI_REPLIES[idx];
        }

