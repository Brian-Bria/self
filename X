            gap: 8px;
            margin-bottom: 24px;
            flex-wrap: wrap;
            align-items: center;
        }
        .growth-tab {
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.70);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: var(--card-shadow);
        }
        .growth-tab:hover {
            border-color: var(--neon-purple);
            color: var(--text-primary);
        }
        .growth-tab.active {
            background: linear-gradient(135deg, rgba(124, 92, 252, 0.10), rgba(244, 114, 182, 0.10));
            border-color: var(--neon-purple);
            color: var(--text-primary);
            box-shadow: 0 0 0 2px rgba(124, 92, 252, 0.06);
        }
        .growth-panel {
            display: none;
            animation: fadeIn 0.4s ease;
        }
        .growth-panel.active {
            display: block;
        }

        .profile-info-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 24px;
            box-shadow: var(--card-shadow);
        }
        .profile-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }
        .profile-info-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .profile-info-item label {
            font-size: 0.85rem;
            color: var(--text-secondary);
        }
        .profile-info-item input,
        .profile-info-item select {
            padding: 10px 14px;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 10px;
            color: var(--text-primary);
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s ease;
            min-height: 44px;
        }
        .profile-info-item input:focus,
        .profile-info-item select:focus {
            border-color: var(--neon-purple);
            box-shadow: 0 0 0 3px rgba(124, 92, 252, 0.06);
        }
        .save-btn {
            padding: 10px 28px;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 8px;
            box-shadow: 0 4px 16px rgba(124, 92, 252, 0.16);
        }
        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(124, 92, 252, 0.24);
        }

        .checkin-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
            transition: all 0.3s ease;
            box-shadow: var(--card-shadow);
        }
        .checkin-card:hover {
            border-color: var(--glass-border-hover);
            transform: translateX(4px);
            box-shadow: var(--card-shadow-hover);
        }
        .checkin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }
        .checkin-date {
            font-weight: 600;
            color: var(--neon-purple);
        }
        .checkin-type {
            font-size: 0.8rem;
            padding: 4px 10px;
            background: rgba(244, 114, 182, 0.10);
            border-radius: 10px;
            color: var(--neon-pink);
        }
        .checkin-content {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 10px;
        }
        .add-checkin-btn {
            width: 100%;
            padding: 16px;
            background: rgba(255, 255, 255, 0.50);
            border: 2px dashed var(--glass-border);
            border-radius: 16px;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            margin-bottom: 20px;
        }
        .add-checkin-btn:hover {
            border-color: var(--neon-purple);
            color: var(--neon-purple);
            background: rgba(124, 92, 252, 0.04);
        }

        .journal-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: var(--card-shadow);
        }
        .journal-card:hover {
            border-color: var(--glass-border-hover);
            transform: translateY(-2px);
            box-shadow: var(--card-shadow-hover);
        }
        .journal-mood {
            font-size: 1.5rem;
            margin-bottom: 8px;
        }
        .journal-text {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 8px;
        }
        .journal-time {
            font-size: 0.8rem;
            color: var(--text-secondary);
            opacity: 0.7;
        }

        .assessment-record-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: var(--card-shadow);
        }
        .assessment-record-card:hover {
            border-color: var(--neon-purple);
            transform: translateX(4px);
            box-shadow: var(--card-shadow-hover);
        }
        .assessment-record-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .assessment-record-date {
            font-weight: 600;
            color: var(--neon-purple);
            font-size: 1rem;
        }
        .assessment-record-total {
            font-size: 1.4rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.05;
        }
        .assessment-record-dims {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            font-size: 0.8rem;
            color: var(--text-secondary);
        }
        .assessment-record-dim {
            display: flex;
            justify-content: space-between;
            padding: 4px 8px;
            background: rgba(124, 92, 252, 0.04);
            border-radius: 6px;
        }
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-secondary);
            opacity: 0.6;
        }
        .empty-state i {
            font-size: 3rem;
            display: block;
            margin-bottom: 12px;
            opacity: 0.3;
        }

        .tag {
            display: inline-block;
            padding: 4px 12px;
            background: rgba(124, 92, 252, 0.08);
            border: 1px solid rgba(124, 92, 252, 0.15);
            border-radius: 20px;
            font-size: 0.8rem;
            color: var(--neon-purple);
            margin-right: 8px;
            margin-bottom: 8px;
        }
        .tag.pink {
            background: rgba(244, 114, 182, 0.08);
            border-color: rgba(244, 114, 182, 0.15);
            color: var(--neon-pink);
        }
        .tag.green {
            background: rgba(5, 150, 105, 0.08);
            border-color: rgba(5, 150, 105, 0.15);
            color: #059669;
        }
        .tag.orange {
            background: rgba(251, 146, 60, 0.08);
            border-color: rgba(251, 146, 60, 0.15);
            color: #f97316;
        }

        /* 滚动条 */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(124, 92, 252, 0.04);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(124, 92, 252, 0.20);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(124, 92, 252, 0.35);
        }

        .loading-overlay {
            position: fixed;
            inset: 0;
            background: #f8f4ff;
            z-index: 3000;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 20px;
            transition: opacity 0.5s ease;
        }
        .loading-overlay.hidden {
            opacity: 0;
            pointer-events: none;
            visibility: hidden;
        }
        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(124, 92, 252, 0.10);
            border-top-color: var(--neon-purple);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
        .loading-text {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        /* 响应式 */
        @media (max-width: 768px) {
            .navbar {
                padding: 10px 16px;
            }
            .nav-links {
                display: none;
            }
            .daily-inspire {
                grid-template-columns: 1fr;
            }
            .welcome-banner {
                flex-direction: column;
                text-align: center;
                padding: 24px 20px;
            }
            .welcome-stats {
                width: 100%;
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 12px;
            }
            .welcome-stat-item {
                min-height: 92px;
                padding: 14px 10px;
            }
            .section-title {
                font-size: 1.4rem;
            }
            .options-grid {
                grid-template-columns: 1fr;
            }
            .video-grid,
            .course-grid,
            .quote-grid {
                grid-template-columns: 1fr;
            }
            .profile-header {
                flex-direction: column;
                text-align: center;
            }
            .back-btn {
                padding: 8px 16px;
                font-size: 0.8rem;
                gap: 4px;
            }
            .xiaohui-chat-section {
                padding: 16px 14px 18px;
            }
            .chat-header {
                flex-direction: column;
                align-items: flex-start;
            }
            .chat-message {
                max-width: 95%;
            }
            .chat-input-area {
                flex-wrap: wrap;
            }
            .chat-input-area input {
                width: 100%;
                flex: auto;
            }
            .chat-input-area .chat-send-btn {
                width: 100%;
                justify-content: center;
                padding: 12px;
            }
            .chat-messages {
                max-height: 280px;
            }
            .main-content {
                padding-top: 72px;
            }
            .section {
                padding: 24px 16px;
            }
            .login-container {
                padding: 28px 16px;
                width: 100%;
                max-width: 100vw;
                overflow-x: hidden;
            }
            .login-hero {
                margin-bottom: 28px;
            }
            .login-hero h1,
            .home-hero h1 {
                font-size: 1.78rem;
            }
            .login-form {
                width: 100%;
                max-width: 100%;
                padding: 28px 22px;
            }
            .login-form,
            .question-card,
            .ai-analysis,
            .message-form,
            .profile-info-card,
            .chart-container {
                padding: 22px;
                border-radius: 18px;
            }
            .platform-highlights {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px;
            }
            .feature-grid,
            .video-grid,
            .course-grid,
            .quote-grid,
            .stats-grid,
            .profile-info-grid {
                gap: 16px;
            }
            .feature-card,
            .daily-card,
            .highlight-card,
            .stat-card,
            .quote-card {
                padding: 20px;
                border-radius: 18px;
            }
            .section-subtitle {
                margin-bottom: 24px;
            }
            .quiz-nav {
                gap: 12px;
            }
            .quiz-nav .btn-neon,
            .quiz-nav .btn-secondary {
                flex: 1;
                min-width: 0;
                padding: 12px 16px !important;
            }
            .assessment-record-dims {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {
            .navbar-brand {
                font-size: 1.05rem;
                max-width: calc(100% - 118px);
            }
            .section-header-row {
                gap: 10px;
            }
            .welcome-stats,
            .platform-highlights {
                grid-template-columns: 1fr;
            }
            .message-header,
            .checkin-header,
            .assessment-record-header {
                align-items: flex-start;
                flex-direction: column;
                gap: 8px;
            }
            .modal-content {
                padding: 26px 22px;
                border-radius: 20px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }

        :focus-visible {
            outline: 2px solid rgba(124, 92, 252, 0.70);
            outline-offset: 3px;
        }

        @media (hover: hover) and (pointer: fine) {
            .btn-neon:hover,
            .message-form button:hover,
            .save-btn:hover,
            .chat-input-area .chat-send-btn:hover:not(:disabled) {
                transform: translateY(-2px);
            }
        }

        .btn-neon:active,
        .message-form button:active,
        .save-btn:active,
        .chat-input-area .chat-send-btn:active:not(:disabled) {
            transform: scale(0.97);
        }

        /* 修正一些文字颜色 */
        .ai-analysis strong {
            color: var(--text-primary);
        }
        .ai-analysis em {
            color: var(--neon-pink);
        }
        .welcome-text h2 span {
            color: var(--text-primary);
        }
        .profile-info-card h3 {
            color: var(--neon-purple);
        }
        .modal-body label {
            color: var(--text-secondary);
        }
    </style>
</head>
