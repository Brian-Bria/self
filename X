        .chat-input-area input:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .chat-input-area .chat-send-btn {
            padding: 12px 24px;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            border: none;
            border-radius: 30px;
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            flex-shrink: 0;
            box-shadow: 0 4px 16px rgba(124, 92, 252, 0.18);
        }
        .chat-input-area .chat-send-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(124, 92, 252, 0.28);
        }
        .chat-input-area .chat-send-btn:active:not(:disabled) {
            transform: scale(0.95);
        }
        .chat-input-area .chat-send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .chat-empty-hint {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.85rem;
            padding: 40px 10px;
            opacity: 0.6;
