            const bubbleWrapper = document.createElement('div');
            const bubble = document.createElement('div');
            bubble.className = 'message-bubble';
            bubble.innerHTML = content.replace(/\n/g, '<br>');

            const time = document.createElement('div');
            time.className = 'msg-time';
            const now = new Date();
            time.textContent = now.getHours().toString().padStart(2, '0') + ':' +
                now.getMinutes().toString().padStart(2, '0');

            bubbleWrapper.appendChild(bubble);
            bubbleWrapper.appendChild(time);
            div.appendChild(avatar);
            div.appendChild(bubbleWrapper);

            container.appendChild(div);
            scrollChatToBottom();
        }

        function appendThinkingMessage() {
            const container = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = 'chat-message ai-message';
            div.id = 'thinking-msg-' + Date.now();

            const avatar = document.createElement('div');
            avatar.className = 'msg-avatar';
            avatar.textContent = '🌙';

            const bubbleWrapper = document.createElement('div');
            const bubble = document.createElement('div');
            bubble.className = 'message-bubble';
            bubble.innerHTML = `
                <div style="display:flex; align-items:center; gap:10px;">
                    <span>小绘Ai 正在思考中</span>
                    <span class="typing-dots">
                        <span></span><span></span><span></span>
                    </span>
                </div>
            `;

            const time = document.createElement('div');
            time.className = 'msg-time';
            const now = new Date();
            time.textContent = now.getHours().toString().padStart(2, '0') + ':' +
                now.getMinutes().toString().padStart(2, '0');

            bubbleWrapper.appendChild(bubble);
            bubbleWrapper.appendChild(time);
            div.appendChild(avatar);
            div.appendChild(bubbleWrapper);
            container.appendChild(div);
            scrollChatToBottom();
            return div.id;
        }

        function removeThinkingMessage(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function scrollChatToBottom() {
            const container = document.getElementById('chatMessages');
            container.scrollTop = container.scrollHeight;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const input = document.getElementById('chatInput');
            if (input) {
                input.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendChatMessage();
                    }
                });
            }
        });

        // ==================== 成长档案 ====================
        function switchGrowthTab(tabName) {
            document.querySelectorAll('.growth-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.growth-panel').forEach(p => p.classList.remove('active'));
            event.target.closest('.growth-tab').classList.add('active');
            document.getElementById('growth-panel-' + tabName).classList.add('active');

            if (tabName === 'assessments') renderGrowthAssessments();
            if (tabName === 'checkins') renderGrowthCheckins();
            if (tabName === 'journals') renderGrowthJournals();
            if (tabName === 'info') updateGrowthOverview();
        }

        function saveChildProfile() {
            const profile = {
                childName: document.getElementById('childName').value,
                childAge: document.getElementById('childAge').value,
                childDisorder: document.getElementById('childDisorder').value,
                guardianName: document.getElementById('guardianName').value,
                guardianPhone: document.getElementById('guardianPhone').value,
                createDate: document.getElementById('createDate').value
            };
            localStorage.setItem('starChildProfile', JSON.stringify(profile));
            alert('孩子信息已保存！');
            updateGrowthOverview();
        }

        function loadChildProfile() {
            const saved = localStorage.getItem('starChildProfile');
            if (saved) {
                const profile = JSON.parse(saved);
                document.getElementById('childName').value = profile.childName || '';
                document.getElementById('childAge').value = profile.childAge || '';
                document.getElementById('childDisorder').value = profile.childDisorder || '';
                document.getElementById('guardianName').value = profile.guardianName || '';
                document.getElementById('guardianPhone').value = profile.guardianPhone || '';
                document.getElementById('createDate').value = profile.createDate || '';
            } else {
                document.getElementById('createDate').value = new Date().toISOString().split('T')[0];
            }
        }

        function updateGrowthOverview() {
            const history = JSON.parse(localStorage.getItem('starChildHistory') || '[]');
            const checkins = JSON.parse(localStorage.getItem('starChildCheckins') || '[]');
            const journals = JSON.parse(localStorage.getItem('starChildJournals') || '[]');

            document.getElementById('growth-assessment-count').textContent = history.length;
            document.getElementById('growth-checkin-count').textContent = checkins.length;
            document.getElementById('growth-journal-count').textContent = journals.length;

            const profile = JSON.parse(localStorage.getItem('starChildProfile') || '{}');
            if (profile.createDate) {
                const createDate = new Date(profile.createDate);
                const today = new Date();
                const days = Math.floor((today - createDate) / (1000 * 60 * 60 * 24));
                document.getElementById('growth-days').textContent = days > 0 ? days : 0;
            } else {
                document.getElementById('growth-days').textContent = 0;
            }
        }

        function renderGrowthAssessments() {
            const history = JSON.parse(localStorage.getItem('starChildHistory') || '[]');
            const container = document.getElementById('growth-assessment-list');

            if (history.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-clipboard-list"></i>
                        <p>暂无测评记录</p>
                        <p style="font-size:0.85rem; margin-top:8px;">完成六维测评后，测评报告将自动保存在这里</p>
                    </div>
                `;
                return;
            }

            const html = history.slice().reverse().map((h, i) => {
                const idx = history.length - 1 - i;
                const dimsHtml = DIMENSIONS.map(d => `
                    <div class="assessment-record-dim">
                        <span>${d.name}</span>
                        <span style="color: var(--text-primary);">${h.scores[d.key]}/${d.maxScore}</span>
                    </div>
                `).join('');

                return `
                    <div class="assessment-record-card" onclick="showHistoryDetail(${idx})">
                        <div class="assessment-record-header">
                            <div class="assessment-record-date">
                                <i class="fas fa-calendar-alt"></i> ${h.date}
                            </div>
                            <div class="assessment-record-total">${h.total}分</div>
                        </div>
                        <div class="assessment-record-dims">
                            ${dimsHtml}
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = html;
        }

        function openCheckinModal() {
            const today = new Date().toISOString().split('T')[0];
            openModal('新增训练打卡', `
                <div style="display:flex; flex-direction:column; gap:16px;">
                    <div>
                        <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:0.9rem;">训练日期</label>
                        <input type="date" id="checkin-date" value="${today}" style="width:100%; padding:10px 14px; background:var(--input-bg); border:1px solid var(--input-border); border-radius:10px; color:var(--text-primary);">
                    </div>
                    <div>
                        <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:0.9rem;">训练类型</label>
                        <select id="checkin-type" style="width:100%; padding:10px 14px; background:var(--input-bg); border:1px solid var(--input-border); border-radius:10px; color:var(--text-primary);">
                            <option value="艺术疗愈">艺术疗愈</option>
                            <option value="感统训练">感统训练</option>
                            <option value="语言训练">语言训练</option>
                            <option value="社交训练">社交训练</option>
                            <option value="ABA训练">ABA训练</option>
                            <option value="其他">其他</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:0.9rem;">训练内容与表现</label>
                        <textarea id="checkin-content" rows="4" placeholder="记录今天的训练内容、孩子的表现和进步..." style="width:100%; padding:12px; background:var(--input-bg); border:1px solid var(--input-border); border-radius:10px; color:var(--text-primary); resize:vertical; font-family:inherit;"></textarea>
                    </div>
                    <div>
                        <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:0.9rem;">训练时长（分钟）</label>
                        <input type="number" id="checkin-duration" placeholder="如：30" style="width:100%; padding:10px 14px; background:var(--input-bg); border:1px solid var(--input-border); border-radius:10px; color:var(--text-primary);">
                    </div>
                    <button onclick="saveCheckin()" style="padding:12px; background:linear-gradient(135deg, var(--neon-purple), var(--neon-pink)); border:none; border-radius:10px; color:#fff; font-size:0.95rem; cursor:pointer; box-shadow:0 4px 16px rgba(124,92,252,0.16);">
                        <i class="fas fa-save"></i> 保存打卡
                    </button>
                </div>
            `);
        }

        function saveCheckin() {
            const checkin = {
                id: Date.now(),
                date: document.getElementById('checkin-date').value,
                type: document.getElementById('checkin-type').value,
                content: document.getElementById('checkin-content').value,
                duration: document.getElementById('checkin-duration').value
            };

            if (!checkin.content.trim()) {
                alert('请填写训练内容');
                return;
            }

            const checkins = JSON.parse(localStorage.getItem('starChildCheckins') || '[]');
            checkins.unshift(checkin);
            localStorage.setItem('starChildCheckins', JSON.stringify(checkins));

            closeModal();
            renderGrowthCheckins();
            updateGrowthOverview();
        }

        function renderGrowthCheckins() {
            const checkins = JSON.parse(localStorage.getItem('starChildCheckins') || '[]');
            const container = document.getElementById('growth-checkin-list');

            if (checkins.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-calendar-check"></i>
                        <p>暂无训练打卡记录</p>
                        <p style="font-size:0.85rem; margin-top:8px;">点击上方按钮，记录今天的训练内容</p>
                    </div>
                `;
                return;
            }

            const html = checkins.map(c => `
                <div class="checkin-card">
                    <div class="checkin-header">
                        <div class="checkin-date"><i class="fas fa-calendar"></i> ${c.date}</div>
                        <span class="checkin-type">${c.type}</span>
                    </div>
                    <div class="checkin-content">${c.content}</div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:0.8rem; color:var(--text-secondary);">
                            <i class="fas fa-clock"></i> ${c.duration || '未记录'} 分钟
                        </span>
                    </div>
                </div>
            `).join('');

            container.innerHTML = html;
        }

        function openJournalModal() {
            const today = new Date().toISOString().split('T')[0];
            openModal('写成长日志', `
                <div style="display:flex; flex-direction:column; gap:16px;">
                    <div>
                        <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:0.9rem;">日期</label>
                        <input type="date" id="journal-date" value="${today}" style="width:100%; padding:10px 14px; background:var(--input-bg); border:1px solid var(--input-border); border-radius:10px; color:var(--text-primary);">
                    </div>
                    <div>
                        <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:0.9rem;">今日心情</label>
                        <div style="display:flex; gap:12px; font-size:1.8rem;">
                            <span class="journal-mood-option" onclick="selectMood('😊')" style="cursor:pointer; padding:4px; border-radius:8px;">😊</span>
                            <span class="journal-mood-option" onclick="selectMood('😐')" style="cursor:pointer; padding:4px; border-radius:8px;">😐</span>
                            <span class="journal-mood-option" onclick="selectMood('😔')" style="cursor:pointer; padding:4px; border-radius:8px;">😔</span>
                            <span class="journal-mood-option" onclick="selectMood('😤')" style="cursor:pointer; padding:4px; border-radius:8px;">😤</span>
                            <span class="journal-mood-option" onclick="selectMood('🥰')" style="cursor:pointer; padding:4px; border-radius:8px;">🥰</span>
                        </div>
                    </div>
                    <div>
                        <label style="display:block; margin-bottom:6px; color:var(--text-secondary); font-size:0.9rem;">日志内容</label>
                        <textarea id="journal-content" rows="6" placeholder="记录今天的心情、孩子的进步、遇到的困难、或者任何想写的..." style="width:100%; padding:12px; background:var(--input-bg); border:1px solid var(--input-border); border-radius:10px; color:var(--text-primary); resize:vertical; font-family:inherit;"></textarea>
                    </div>
                    <button onclick="saveJournal()" style="padding:12px; background:linear-gradient(135deg, var(--neon-purple), var(--neon-pink)); border:none; border-radius:10px; color:#fff; font-size:0.95rem; cursor:pointer; box-shadow:0 4px 16px rgba(124,92,252,0.16);">
                        <i class="fas fa-save"></i> 保存日志
                    </button>
                </div>
            `);
            window.currentMood = '😊';
        }

        function selectMood(mood) {
            window.currentMood = mood;
            document.querySelectorAll('.journal-mood-option').forEach(el => {
                el.style.background = 'transparent';
            });
            event.target.style.background = 'rgba(124,92,252,0.12)';
        }

        function saveJournal() {
            const journal = {
                id: Date.now(),
                date: document.getElementById('journal-date').value,
                mood: window.currentMood || '😊',
                content: document.getElementById('journal-content').value
            };

            if (!journal.content.trim()) {
                alert('请填写日志内容');
                return;
            }

            const journals = JSON.parse(localStorage.getItem('starChildJournals') || '[]');
            journals.unshift(journal);
            localStorage.setItem('starChildJournals', JSON.stringify(journals));

            closeModal();
            renderGrowthJournals();
            updateGrowthOverview();
        }

        function renderGrowthJournals() {
            const journals = JSON.parse(localStorage.getItem('starChildJournals') || '[]');
            const container = document.getElementById('growth-journal-list');

            if (journals.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-book-open"></i>
                        <p>暂无成长日志</p>
                        <p style="font-size:0.85rem; margin-top:8px;">记录孩子的每一点进步，也记录自己的心情</p>
                    </div>
                `;
                return;
            }

            const html = journals.map(j => `
                <div class="journal-card">
                    <div class="journal-mood">${j.mood}</div>
                    <div class="journal-text">${j.content}</div>
                    <div class="journal-time"><i class="fas fa-calendar"></i> ${j.date}</div>
                </div>
            `).join('');

            container.innerHTML = html;
        }

        // ==================== 初始化 ====================
        window.addEventListener('DOMContentLoaded', () => {
            initParticles();
            const saved = localStorage.getItem('starChildUser');
            if (saved) { currentUser = JSON.parse(saved);
                initApp(); }
            currentQuestion = 0;
            answers = new Array(QUESTIONS.length).fill(null);
            renderQuestion();
            setTimeout(() => { document.getElementById('loading').classList.add('hidden'); }, 800);
        });

        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
    </script>
</body>
</html>
