<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>一星一艺·三阶六维艺术疗愈平台</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js">
    </script>
    <style>
        /* ========== 明亮主题配色 ========== */
        :root {
            --bg-deep: #f7f2ff;
            --bg-mid: #f5edfa;
            --glass-bg: rgba(255, 255, 255, 0.72);
            --glass-border: rgba(108, 92, 231, 0.15);
            --glass-border-hover: rgba(108, 92, 231, 0.30);
            --neon-purple: #7c5cfc;
            --neon-pink: #f472b6;
            --neon-blue: #8b7bf7;
            --text-primary: #2d2a4a;
            --text-secondary: #6b6a8a;
            --accent-glow: rgba(124, 92, 252, 0.18);
            --card-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
            --card-shadow-hover: 0 16px 44px rgba(0, 0, 0, 0.10);
            --input-bg: rgba(124, 92, 252, 0.04);
            --input-border: rgba(124, 92, 252, 0.14);
            --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
            --copy-muted: rgba(45, 42, 74, 0.78);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(145deg, #f8f4ff 0%, #f5edfa 40%, #fce8f0 100%);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.45;
        }

        /* 导航栏 - 明亮版 */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(124, 92, 252, 0.10);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            box-shadow: 0 1px 12px rgba(0, 0, 0, 0.04);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: 700;
            background: linear-gradient(90deg, var(--neon-purple), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .navbar-brand i {
            font-size: 1.4rem;
        }

        .nav-links {
            display: flex;
            gap: 6px;
            list-style: none;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 24px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--text-primary);
            background: rgba(124, 92, 252, 0.10);
            border-color: rgba(124, 92, 252, 0.20);
            box-shadow: 0 0 16px rgba(124, 92, 252, 0.08);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #fff;
            border: 2px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 2px 8px rgba(124, 92, 252, 0.15);
        }

        .main-content {
            position: relative;
            z-index: 1;
            padding-top: 80px;
            min-height: 100vh;
        }

        .section {
            display: none;
            padding: 40px 24px;
            max-width: 1200px;
            margin: 0 auto;
            animation: fadeIn 0.5s ease;
        }
        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* 返回按钮 - 明亮版 */
        .back-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.70);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(124, 92, 252, 0.12);
            border-radius: 30px;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            white-space: nowrap;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
        }
        .back-btn i {
            font-size: 0.85rem;
            transition: transform 0.3s ease;
        }
        .back-btn:hover {
            color: var(--text-primary);
            background: rgba(124, 92, 252, 0.10);
            border-color: rgba(124, 92, 252, 0.30);
            box-shadow: 0 6px 20px rgba(124, 92, 252, 0.12);
            transform: translateX(-4px);
        }
        .back-btn:hover i {
            transform: translateX(-3px);
        }
        .back-btn:active {
            transform: scale(0.95);
            transition: transform 0.15s ease;
        }

        .section-header-row {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 8px;
            flex-wrap: wrap;
        }
        .section-header-row .section-title {
            margin-bottom: 0;
        }
        .section-subtitle {
            color: var(--text-secondary);
            margin-bottom: 32px;
            font-size: 0.95rem;
            max-width: 760px;
            line-height: 1.72;
        }

        /* 毛玻璃卡片 - 明亮版 */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 24px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            box-shadow: var(--card-shadow);
        }
        .glass-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(124, 92, 252, 0.06) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }
        .glass-card:hover::before {
            opacity: 1;
        }
        .glass-card:hover {
            transform: translateY(-8px);
            border-color: var(--glass-border-hover);
            box-shadow: var(--card-shadow-hover);
        }

        /* 登录页 - 明亮版 */
        .login-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: calc(100vh - 80px);
            padding: 40px 20px;
        }
        .login-hero {
            text-align: center;
            margin-bottom: 40px;
            max-width: 720px;
            width: 100%;
        }
        .login-hero h1 {
            font-size: clamp(1.9rem, 3.8vw, 2.5rem);
            margin-bottom: 12px;
            background: linear-gradient(90deg, var(--neon-purple), var(--neon-pink), var(--neon-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.18;
        }
        .login-hero p {
            color: var(--text-secondary);
            font-size: 1.1rem;
            max-width: 680px;
            margin: 0 auto;
            line-height: 1.72;
        }

        .login-form {
            width: 100%;
            max-width: 420px;
            background: rgba(255, 255, 255, 0.80);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(124, 92, 252, 0.12);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.04);
        }

        .form-group {
            margin-bottom: 24px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }
        .form-group input {
            width: 100%;
            padding: 14px 18px;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 1rem;
            transition: all 0.3s ease;
            outline: none;
            min-height: 46px;
        }
        .form-group input:focus {
            border-color: var(--neon-purple);
            box-shadow: 0 0 0 3px rgba(124, 92, 252, 0.10);
            background: rgba(124, 92, 252, 0.06);
        }
        .form-group input::placeholder {
            color: rgba(107, 106, 138, 0.40);
        }

        .btn-neon {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            border: none;
            border-radius: 12px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(124, 92, 252, 0.20);
        }
        .btn-neon::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            transition: left 0.5s ease;
        }
        .btn-neon:hover::after {
            left: 100%;
        }
        .btn-neon:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(124, 92, 252, 0.30);
        }
        .btn-neon:active {
            transform: scale(0.97);
        }

        .section-title {
            font-size: 1.8rem;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 750;
            color: var(--text-primary);
        }
        .section-title i {
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* ===== 测评 ===== */
        .quiz-container {
            max-width: 800px;
            margin: 0 auto;
        }
        .quiz-progress {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
            position: relative;
        }
        .quiz-progress::before {
            content: '';
            position: absolute;
            top: 14px;
            left: 0;
            right: 0;
            height: 2px;
            background: rgba(124, 92, 252, 0.12);
            z-index: 0;
        }
        .progress-bar {
            position: absolute;
            top: 14px;
            left: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--neon-purple), var(--neon-pink));
            transition: width 0.5s ease;
            z-index: 1;
        }
        .progress-step {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(124, 92, 252, 0.08);
            border: 2px solid rgba(124, 92, 252, 0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: var(--text-secondary);
            z-index: 2;
            transition: all 0.3s ease;
        }
        .progress-step.active {
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            border-color: transparent;
            color: #fff;
            box-shadow: 0 0 20px rgba(124, 92, 252, 0.25);
            transform: scale(1.04);
        }
        .progress-step.completed {
            background: var(--neon-purple);
            border-color: var(--neon-purple);
            color: #fff;
        }

        .question-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 32px;
            margin-bottom: 24px;
            box-shadow: var(--card-shadow);
        }
        .question-number {
            display: inline-block;
            padding: 4px 14px;
            background: rgba(124, 92, 252, 0.10);
            border-radius: 20px;
            font-size: 0.8rem;
            color: var(--neon-purple);
            margin-bottom: 16px;
        }
        .question-text {
            font-size: 1.15rem;
            margin-bottom: 24px;
            line-height: 1.6;
            color: var(--text-primary);
        }
        .options-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
        .option-btn {
            padding: 16px;
            background: rgba(124, 92, 252, 0.04);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: left;
            font-size: 0.95rem;
            line-height: 1.2;
        }
        .option-btn:hover {
            background: rgba(124, 92, 252, 0.08);
            border-color: var(--neon-purple);
            transform: translateX(4px);
        }
        .option-btn.selected {
            background: linear-gradient(135deg, rgba(124, 92, 252, 0.14), rgba(244, 114, 182, 0.14));
            border-color: var(--neon-purple);
            box-shadow: 0 0 0 2px rgba(124, 92, 252, 0.10);
        }
        .option-btn small {
            color: var(--text-secondary);
            font-size: 0.8rem;
        }
        .quiz-nav {
            display: flex;
            justify-content: space-between;
            margin-top: 32px;
            gap: 12px;
        }
        .btn-secondary {
            padding: 12px 28px;
            background: rgba(255, 255, 255, 0.70);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.95rem;
            box-shadow: var(--card-shadow);
        }
        .btn-secondary:hover {
            background: rgba(124, 92, 252, 0.08);
            border-color: var(--neon-blue);
        }

        /* 分析结果 - 明亮版 */
        .analysis-container {
            max-width: 900px;
            margin: 0 auto;
        }
        .radar-chart-wrapper {
            width: 100%;
            max-width: 500px;
            margin: 0 auto 40px;
        }
        .dimension-scores {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 16px;
            margin-bottom: 40px;
        }
        .score-item {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.3s ease;
            box-shadow: var(--card-shadow);
        }
        .score-item:hover {
            border-color: var(--glass-border-hover);
            transform: translateY(-4px);
            box-shadow: var(--card-shadow-hover);
        }
        .score-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #fff;
            flex-shrink: 0;
        }
        .score-icon.social {
            background: linear-gradient(135deg, #7c5cfc, #a78bfa);
        }
        .score-icon.language {
            background: linear-gradient(135deg, #f472b6, #fb9bc2);
        }
        .score-icon.cognitive {
            background: linear-gradient(135deg, #34d399, #6ee7b7);
        }
        .score-icon.sensory {
            background: linear-gradient(135deg, #fbbf24, #fcd34d);
        }
        .score-icon.emotion {
            background: linear-gradient(135deg, #f87171, #fca5a5);
        }
        .score-icon.life {
            background: linear-gradient(135deg, #60a5fa, #93bbfc);
        }
        .score-info {
            flex: 1;
        }
        .score-info h4 {
            font-size: 0.95rem;
            margin-bottom: 4px;
            color: var(--text-primary);
        }
        .score-info span {
            font-size: 0.8rem;
            color: var(--text-secondary);
        }
        .score-value {
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.05;
        }

        .ai-analysis {
            background: linear-gradient(135deg, rgba(124, 92, 252, 0.06), rgba(244, 114, 182, 0.06));
            border: 1px solid rgba(124, 92, 252, 0.18);
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 32px;
        }
        .ai-analysis h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            color: var(--neon-purple);
        }
        .ai-analysis p {
            line-height: 1.8;
            color: var(--text-secondary);
        }

        /* 视频、课程、语录卡片 - 明亮版 */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 24px;
        }
        .video-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s ease;
            cursor: pointer;
            box-shadow: var(--card-shadow);
        }
        .video-card:hover {
            transform: translateY(-8px);
            border-color: var(--glass-border-hover);
            box-shadow: var(--card-shadow-hover);
        }
        .video-thumb {
            width: 100%;
            height: 180px;
            background: linear-gradient(135deg, rgba(124, 92, 252, 0.20), rgba(244, 114, 182, 0.20));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: rgba(45, 42, 74, 0.20);
            position: relative;
            overflow: hidden;
        }
        .video-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-play-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.30);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .video-card:hover .video-play-overlay {
            opacity: 1;
        }
        .play-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.92);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--neon-purple);
            font-size: 1.5rem;
            transition: all 0.3s ease;
        }
        .play-btn:hover {
            transform: scale(1.10);
            background: #fff;
        }
        .video-info {
            padding: 16px;
        }
        .video-tag {
            display: inline-block;
            padding: 2px 12px;
            background: rgba(124, 92, 252, 0.10);
            border-radius: 12px;
            font-size: 0.75rem;
            color: var(--neon-purple);
            margin-bottom: 8px;
        }
        .video-title {
            font-size: 1rem;
            margin-bottom: 8px;
            line-height: 1.4;
            font-weight: 650;
            color: var(--text-primary);
        }
        .video-meta {
            font-size: 0.8rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
        }
        .course-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s ease;
            cursor: pointer;
            box-shadow: var(--card-shadow);
        }
        .course-card:hover {
            transform: translateY(-8px);
            border-color: var(--glass-border-hover);
            box-shadow: var(--card-shadow-hover);
        }
        .course-header {
            padding: 24px;
            background: linear-gradient(135deg, rgba(124, 92, 252, 0.08), rgba(244, 114, 182, 0.08));
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .course-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: rgba(124, 92, 252, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--neon-purple);
        }
        .course-header h3 {
            font-size: 1.1rem;
            color: var(--text-primary);
            font-weight: 650;
        }
        .course-body {
            padding: 20px;
        }
        .course-body p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 16px;
        }
        .course-stats {
            display: flex;
            gap: 16px;
            font-size: 0.8rem;
            color: var(--text-secondary);
        }
        .course-stats span {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .quote-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 24px;
        }
        .quote-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 28px;
            position: relative;
            transition: all 0.4s ease;
            cursor: pointer;
            box-shadow: var(--card-shadow);
        }
