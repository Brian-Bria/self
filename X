            display: flex;
            align-items: center;
            gap: 14px;
        }
        .chat-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: #fff;
            box-shadow: 0 4px 20px rgba(124, 92, 252, 0.20);
            flex-shrink: 0;
            user-select: none;
